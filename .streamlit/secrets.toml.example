# Railway Database Configuration
[railway_db]
host = "your-host.proxy.rlwy.net"
port = 12345
database = "railway"
user = "postgres"
password = "your_password_here"
sslmode = "require"

# Cin7 API Configuration
[cin7]
base_url = "https://api.cin7.com/api/"
api_username = "your_cin7_username"
api_key = "your_cin7_api_key"
branch_hamilton_id = 230
branch_hamilton_default_member = 230
branch_avondale_id = 3
branch_avondale_default_member = 3
